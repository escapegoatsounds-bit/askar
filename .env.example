# Local-first Askar: no Supabase needed. Your data lives in
#   %USERPROFILE%\Documents\Land of Rebirth Data   (db\*.json tables + media\ images)
# Set LOR_DATA to use a different folder.
# LOR_DATA=D:\Land of Rebirth Data

# Map (Mapbox public token, starts with pk.)
VITE_MAPBOX_TOKEN=pk.your-public-token

# Optional search keys (searching new images still needs internet)
YOUTUBE_API_KEY=
SMITHSONIAN_API_KEY=
